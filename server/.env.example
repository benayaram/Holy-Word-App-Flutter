# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Appserver

# Firebase Admin SDK (base64-encoded service account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=<base64-encoded-service-account-json>

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=<your-gemini-api-key>

# JWT Secret for additional token signing if needed
JWT_SECRET=<random-256-bit-hex-string>

# Server Config
PORT=3000
NODE_ENV=production
CORS_ORIGIN=*
